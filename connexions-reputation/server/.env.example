# Copy this file to .env (same folder) and fill it in. .env is git-ignored. Never commit it.

# Which SMS provider sends texts: twilio | txtria | test (test logs only, sends nothing)
SMS_PROVIDER=test

# Shared key the dashboard must send (Settings > Delivery > Server access key). Make it long and random.
ACCESS_KEY=

# Secret for the inbound-reply URL: https://YOUR-HOST/api/sms/inbound?token=THIS_VALUE
INBOUND_TOKEN=

# Twilio (console.twilio.com > Account Info). TWILIO_FROM is your Twilio number, or a Messaging Service SID (MG...).
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# Txtria (txtria.com console). TXTRIA_FROM is your 10-digit TxTRIA number.
TXTRIA_SYS_ID=
TXTRIA_AUTH_TOKEN=
TXTRIA_FROM=

# Optional
PORT=8820
# HOST=0.0.0.0 when hosted behind a reverse proxy; keep 127.0.0.1 on this PC.
HOST=127.0.0.1
# Comma-separated browser origins allowed to call the API from another address (blank = any origin, key still required).
ALLOWED_ORIGINS=
